#!/usr/bin/env bash
#
# scripts/dev — run ONE toolchain command in the pinned toolbox container.
#
# There is no node, pnpm or terraform on this host and there must not be
# (DOCKER.md §0.1). This script is how every agent runs one.
#
#   scripts/dev pnpm install
#   scripts/dev pnpm -w typecheck
#   scripts/dev terraform -chdir=infra validate
#
# Properties this script is responsible for (DOCKER.md §4.2, §7):
#   * the repo is bind-mounted at its REAL host path, so paths in output and
#     in tsconfig/turbo caches mean the same thing inside and outside;
#   * the container runs as the invoking uid:gid, so nothing lands root-owned;
#   * the pnpm store is a named volume, so installs are not re-downloaded;
#   * the container is attached to kinvara-build (egress) and to NOTHING else.
#     No service is ever reachable from here. A command that needs a service
#     runs under `scripts/svc run <ticket> -- ...`, which gets services and no
#     egress. The two never overlap — that is what makes "no live credentials"
#     structural rather than a rule someone has to remember.
#   * no arguments is an error, not a shell.
#
# --- T-016 / OD-1 ----------------------------------------------------------
# The pin loop and the image tag used to be written out here and enumerated
# FOUR tools by hand. T-001 added `gitleaks` and `trivy` to .tool-versions, and
# bumping either changed nothing the tag could see: the cached image was
# silently reused and an agent ran a stale binary while believing the pin.
# Both now come from scripts/lib/toolbox.sh, which derives them from EVERY line
# in .tool-versions and from no hand-written list. scripts/svc run uses the
# same file, so the two entry points cannot drift.

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${SCRIPT_PATH}")"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
TOOL_VERSIONS="${REPO_ROOT}/.tool-versions"
DOCKERFILE="${REPO_ROOT}/docker/toolbox.Dockerfile"

BUILD_NETWORK="kinvara-build"
PNPM_STORE_VOLUME="kinvara-pnpm-store"

# shellcheck source=scripts/lib/toolbox.sh
. "${SCRIPT_DIR}/lib/toolbox.sh"

die() { printf 'scripts/dev: %s\n' "$*" >&2; exit 1; }

usage() {
    cat >&2 <<'USAGE'
usage: scripts/dev [--build] [--playwright] [--docker] <command> [args...]

Runs exactly one command inside the pinned Kinvara toolbox container
(docker/toolbox.Dockerfile, versions from .tool-versions). No services are
attached; the container has egress and nothing else.

  --build       rebuild the toolbox image even if it already exists
  --playwright  use the Playwright variant (browsers included; heavy gates only)
  --docker      mount the Docker socket, so Testcontainers can acquire a
                database (OD-16/OD-18). OFF by default and NEVER available
                under `scripts/svc run` — see the ruling in
                scripts/lib/toolbox.sh. Use it only for suites that create
                their own containers.
  -h, --help    this message

examples:
  scripts/dev node --version
  scripts/dev pnpm install
  scripts/dev pnpm -w typecheck
  scripts/dev terraform -chdir=infra validate
  scripts/dev --docker pnpm --filter db-testkit test    # Testcontainers

A command that needs a running service is NOT run here — use
  scripts/svc run <ticket> -- <command>
USAGE
}

# --- pins ------------------------------------------------------------------
[[ -f "${TOOL_VERSIONS}" ]] || die "missing ${TOOL_VERSIONS}"
[[ -f "${DOCKERFILE}" ]]    || die "missing ${DOCKERFILE}"

toolbox_load_pins "${TOOL_VERSIONS}" || exit 1

# Before anything else: the toolbox never runs as root (OD-16). Doing so would
# make every file it writes into the bind mount root-owned and undo the
# property T-000 measured.
toolbox_refuse_root "scripts/dev" || exit 1

# --- arguments -------------------------------------------------------------
FORCE_BUILD=0
TARGET="toolbox"
# The Docker socket is OFF unless this invocation asks for it. Do not change
# the default: gate:toolbox §6 asserts that a gate run cannot see the daemon,
# and it is deliberately unconditional so that making the socket always-on
# turns gate:pr red rather than passing quietly (OD-16).
WANT_DOCKER=0
KINVARA_DOCKER_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --build)       FORCE_BUILD=1; shift ;;
        --playwright)  TARGET="toolbox-playwright"; shift ;;
        --docker)      WANT_DOCKER=1; shift ;;
        -h|--help)     usage; exit 0 ;;
        --)            shift; break ;;
        -*)            die "unknown option '$1' (see --help)" ;;
        *)             break ;;
    esac
done

# The gate: no command means usage and a non-zero exit. Never a shell.
if [[ $# -eq 0 ]]; then
    printf 'scripts/dev: no command given.\n\n' >&2
    usage
    exit 2
fi

# --- image -----------------------------------------------------------------
# The tag encodes EVERY pin in .tool-versions — the readable node/pnpm/tf
# prefix for a human reading `docker images`, and a fingerprint of the whole
# file so that no pin can change without the tag changing (OD-1).
command -v docker >/dev/null 2>&1 || die "docker is not installed"

IMAGE="$(toolbox_image_tag "${TOOL_VERSIONS}" "${TARGET}")"
toolbox_ensure_image "${IMAGE}" "${TARGET}" "${DOCKERFILE}" "${REPO_ROOT}/docker" "${FORCE_BUILD}"

# --- the one permitted egress network (DOCKER.md §7) -----------------------
if ! docker network inspect "${BUILD_NETWORK}" >/dev/null 2>&1; then
    docker network create \
        --label io.kinvara.network=build \
        --label io.kinvara.egress=permitted \
        "${BUILD_NETWORK}" >/dev/null
fi

docker volume inspect "${PNPM_STORE_VOLUME}" >/dev/null 2>&1 || \
    docker volume create --label io.kinvara.volume=pnpm-store "${PNPM_STORE_VOLUME}" >/dev/null

# --- working directory -----------------------------------------------------
# Mirror the caller's cwd when it is inside the repo; otherwise the repo root.
HOST_CWD="$(pwd -P)"
if [[ "${HOST_CWD}" == "${REPO_ROOT}" || "${HOST_CWD}" == "${REPO_ROOT}/"* ]]; then
    WORKDIR="${HOST_CWD}"
else
    WORKDIR="${REPO_ROOT}"
fi

# The repo bind mount, plus the main repository's .git when this is a LINKED
# git worktree — without it every git command inside the container fails,
# which is the caveat DOCKER.md §9.1b names as blocking parallel dispatch.
toolbox_mount_args "${REPO_ROOT}"

# The Docker socket, only when explicitly asked for. Four flags, not one:
# without --group-add the connect is EACCES, and without --add-host the
# SIBLING CONTAINER'S published port is unreachable — see OD-16 and OD-18.
if [[ "${WANT_DOCKER}" -eq 1 ]]; then
    toolbox_docker_socket_args || exit 1
fi

# A TTY only when the caller actually has one on both ends: otherwise docker
# rewrites LF as CRLF and captured output stops being byte-comparable.
TTY_FLAGS=()
if [[ -t 0 && -t 1 ]]; then
    TTY_FLAGS=(--tty)
fi

exec docker run \
    --rm \
    --interactive \
    "${TTY_FLAGS[@]}" \
    --network "${BUILD_NETWORK}" \
    --user "$(id -u):$(id -g)" \
    "${KINVARA_MOUNT_ARGS[@]}" \
    "${KINVARA_DOCKER_ARGS[@]}" \
    --volume "${PNPM_STORE_VOLUME}:/pnpm-store" \
    --workdir "${WORKDIR}" \
    --env "HOME=/home/toolbox" \
    --env "CI=1" \
    --env "TZ=UTC" \
    --env "LANG=C.UTF-8" \
    --label "io.kinvara.toolbox=1" \
    "${IMAGE}" "$@"
