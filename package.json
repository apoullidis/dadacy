{
  "name": "kinvara",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kinvara monorepo — pnpm workspace + Turborepo (SD §DH-1)",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/gates/lint.ts",
    "format": "prettier --write .",
    "test": "node scripts/gates/turbo-task.ts test",
    "test:integration": "node scripts/gates/turbo-task.ts test:integration",
    "build": "turbo run build",
    "size-limit": "node scripts/gates/size-limit.ts",
    "db:introspect": "node scripts/db-introspect.ts --write",
    "db:introspect:check": "node scripts/db-introspect.ts --check",
    "db:migrate": "node scripts/db-migrate.ts",
    "gate:typecheck": "pnpm run --silent typecheck && echo '\nGATE PASS  gate:typecheck'",
    "gate:lint": "pnpm run --silent lint",
    "gate:deps": "node scripts/gates/deps.ts",
    "gate:secrets": "node scripts/gates/secrets.ts",
    "gate:trivy": "node scripts/gates/trivy.ts",
    "gate:size-limit": "pnpm run --silent size-limit",
    "gate:toolbox": "node scripts/gates/toolbox.ts",
    "gate:egress-boundary": "node scripts/gates/egress-boundary.ts",
    "gate:app-images": "node scripts/gates/app-images.ts",
    "gate:otel-contract": "node scripts/gates/otel-contract.ts",
    "gate:semgrep": "node scripts/gates/semgrep.ts",
    "gate:contract-drift": "node scripts/gates/contract-drift.ts",
    "gate:constraint-suite": "node scripts/gates/constraint-suite.ts",
    "gate:constraint-suite:static": "node scripts/gates/constraint-suite.ts --static",
    "gate:migration-lint": "node scripts/gates/migration-lint.ts",
    "gate:audit": "node scripts/gates/audit.ts",
    "gate:no-unsafe-any": "node scripts/gates/no-unsafe-any.ts",
    "gate:semgrep-rules": "node scripts/gates/semgrep-rules.ts",
    "gate:unit-tests": "node scripts/gates/unit-tests.ts",
    "gate:policy-coverage": "node scripts/gates/policy-coverage.ts",
    "gate:negative-suites": "node scripts/gates/negative-suites.ts",
    "gate:supply-chain": "node scripts/gates/supply-chain.ts",
    "gate:workflow": "node scripts/gates/workflow.ts",
    "gate:pr-gate-suite": "node scripts/gates/pr-gate-suite.ts",
    "gate:drizzle-parity": "node scripts/gates/drizzle-parity.ts",
    "gate:locale-completeness": "node packages/i18n/tools/locale-completeness.ts",
    "gate:prohibited-claims": "node scripts/gates/not-yet-supplied.ts gate:prohibited-claims",
    "gate:safety-review-currency": "node packages/i18n/tools/safety-review-currency.ts",
    "gate:plural-completeness": "node scripts/gates/not-yet-supplied.ts gate:plural-completeness",
    "gate:sms-segments": "node packages/i18n/tools/sms-segments.ts",
    "gate:pii-canary": "node scripts/gates/not-yet-supplied.ts gate:pii-canary",
    "gate:pr": "node scripts/gates/pr.ts",
    "gate:lighthouse": "node scripts/gates/not-yet-supplied.ts gate:lighthouse",
    "gate:axe": "node scripts/gates/not-yet-supplied.ts gate:axe",
    "gate:playwright-journeys": "node scripts/gates/not-yet-supplied.ts gate:playwright-journeys",
    "gate:db-introspect-suite": "node scripts/gates/db-introspect-suite.ts",
    "gate:heavy": "node scripts/gates/heavy.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@size-limit/file": "13.0.3",
    "@types/node": "26.4.1",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "size-limit": "13.0.3",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "yaml": "2.8.1"
  }
}
