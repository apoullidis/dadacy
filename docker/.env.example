# Kinvara — THE ENVIRONMENT CONTRACT. Committed on purpose (DOCKER.md §2).
#
# `scripts/svc` reads `docker/.env` if it exists and `docker/.env.example`
# otherwise, and uses the same file for BOTH:
#
#   * compose variable substitution when starting services, and
#   * the environment injected into the toolbox by `scripts/svc run`.
#
# One file, so a service and the test process talking to it can never be
# configured differently. `docker/.env` is git-ignored; create one only to
# override a value locally, and never to hold a credential.
#
# ===========================================================================
# THE ONE THING TO GET RIGHT
# ===========================================================================
# Every URL below addresses a service by its COMPOSE SERVICE NAME on its
# DEFAULT PORT — postgres:5432, valkey:6379, core:3000. That is the only form
# that works under `scripts/svc run`, which puts your process on the ticket's
# internal network alongside the services.
#
# It is NOT the ephemeral host port from `scripts/svc port`. Those exist for a
# human with a browser (`scripts/svc env` prints them), and a test that uses
# one will fail on someone else's machine, in someone else's ticket, as a
# flake. Do not write `localhost` in any of these values.
#
# ===========================================================================
# THERE ARE NO REAL CREDENTIALS HERE AND THERE NEVER WILL BE
# ===========================================================================
# Every value is a local stand-in: LocalStack, stripe-mock, fake-telephony,
# Mailpit. Services run on `kinvara-int`, which is `internal: true` — a packet
# cannot leave this host, so a test cannot start passing because it silently
# reached a real endpoint. A ticket that appears to need a live key is BLOCKED
# and escalated, never improvised (PROTOCOL.md §9.9).

# --- Postgres (profile: db) -------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_dev_only
POSTGRES_DB=kinvara
DATABASE_URL=postgres://app:app_local_dev_only@postgres:5432/kinvara

# psql/pg_dump read these, so `svc run <t> -- psql` needs no arguments at all.
PGHOST=postgres
PGPORT=5432
PGUSER=app
PGPASSWORD=app_local_dev_only
PGDATABASE=kinvara

# --- Valkey (profile: cache) ------------------------------------------------
VALKEY_URL=redis://valkey:6379

# --- LocalStack (profile: aws) — seeded by T-017 ----------------------------
# What is seeded is declared once, in docker/fakes/seed/lib/manifest.sh, and
# verified by the same file:
#   scripts/svc exec <ticket> localstack /opt/kinvara/seed/verify.sh
# KMS keys are addressed by ALIAS (`alias/kinvara-<purpose>`), never by key id
# — the id differs on every fresh project.
# eu-central-1 (Frankfurt) is a compliance fact, not a default
# (SA §TS-8r). DR destination is eu-west-1. Never us-east-1.
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- stripe-mock (profile: pay) ---------------------------------------------
STRIPE_API_BASE=http://stripe-mock:12111
STRIPE_SECRET_KEY=sk_test_stripe_mock_local_only
STRIPE_WEBHOOK_SECRET=whsec_stripe_mock_local_only

# --- fake-telephony (profile: tel) — T-017 ----------------------------------
# Returns 501 Not Implemented on every inbound-SMS route (SA §INT-5r). Cyprus
# supports neither two-way SMS through major providers nor domestic long codes,
# so the SMS-reply acknowledgement rung does not exist in this market. The fake
# refuses it so nobody can build it and hide it behind a green test.
TELEPHONY_BASE_URL=http://fake-telephony:4000

# Where fake-telephony POSTs its webhooks (call.initiated, call.answered,
# call.dtmf). EMPTY by default: webhooks are then recorded with delivery
# `not_configured` and nothing is sent. Point it at a service on this same
# internal network when a ticket needs delivery, e.g. http://safety-gw:3010.
TELEPHONY_WEBHOOK_BASE=

# The inbound safety-line number WE own and forward to the answering-service
# vendor, so the 15-minute acknowledgement clock starts at our webhook rather
# than at the vendor's report (EV-1).
TELEPHONY_SAFETY_LINE=+35722000199

# Alphanumeric sender ID — fully supported in Cyprus, no pre-registration,
# preserved as sent (SA §INT-5r).
TELEPHONY_SENDER_ID=Kinvara

# --- Mailpit (profile: mail) ------------------------------------------------
SMTP_URL=smtp://mailpit:1025
MAILPIT_API_BASE=http://mailpit:8025

# --- hibp-fake (profile: hibp) — T-139 --------------------------------------
# The HIBP Pwned Passwords k-anonymity range API stand-in. The ONLY request it
# answers is GET ${HIBP_API_BASE}/range/<first 5 hex of the SHA-1>, exactly as
# https://api.pwnedpasswords.com/range/<prefix>. Keyless, like the real one.
HIBP_API_BASE=http://hibp-fake:4100

# --- OpenTelemetry (profile: otel) — T-008 ----------------------------------
# The collector's OTLP/HTTP receiver. `@kinvara/observability` posts
# `${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/traces` and `/v1/metrics` with the JSON
# encoding; there is no OpenTelemetry SDK in this repository and adding one is
# a supply-chain decision, not a convenience (packages/observability/src/otlp.ts).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# The default `service.name` for a process that does not set its own. `core`
# overrides it to `kinvara-core` in compose.yml; a second service on the same
# collector MUST have its own name or Jaeger merges the two.
OTEL_SERVICE_NAME=kinvara
# Set to `true` to make every exporter a no-op. Its only supported use is a
# process running WITHOUT the `otel` profile: without it, every export fails
# against an absent collector and the failure is counted and printed.
OTEL_SDK_DISABLED=
# Jaeger's query API, for a test that asserts what actually arrived.
JAEGER_QUERY_BASE=http://jaeger:16686

# --- Sentry (SA §TS-10) -----------------------------------------------------
# DELIBERATELY EMPTY AND IT MUST STAY EMPTY. There is no Sentry account for
# this build, and every application container is on `internal: true`
# `kinvara-int` with no route off the host (DOCKER.md §7). `initSentry()`
# REFUSES a non-empty value rather than letting a container discover at run
# time that its packets cannot leave (PROTOCOL §9.9: blocked and escalated,
# never improvised). The `beforeSend` scrubber is real and unit-tested; the
# destination is not.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
KINVARA_ENV=local
KINVARA_RELEASE=dev

# --- Application services (profiles: api / worker / safety / web / admin) ---
NODE_ENV=development
CORE_BASE_URL=http://core:3000
SAFETY_GW_BASE_URL=http://safety-gw:3010
WEB_BASE_URL=http://web:3001
ADMIN_BASE_URL=http://admin:3002
TZ=UTC
